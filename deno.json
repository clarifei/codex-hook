{
  "imports": {
    "@opentui/core": "npm:@opentui/core@0.5.1",
    "@opentui/core/testing": "npm:@opentui/core@0.5.1/testing"
  },
  "nodeModulesDir": "none",
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true
  },
  "tasks": {
    "check": "deno fmt --check deno.json package.json hooks.json scripts hooks && deno lint scripts hooks && deno check scripts/*.ts scripts/lib/*.ts hooks/*.ts hooks/lib/*.ts",
    "headroom": "deno run --allow-env --allow-read --allow-write --allow-sys scripts/enable-headroom.ts",
    "install": "deno run -A scripts/install.ts",
    "test": "deno test -A scripts/install_test.ts",
    "tui:smoke": "deno run -A scripts/run-bun.ts scripts/tui-smoke.ts"
  }
}
