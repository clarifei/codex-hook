{
  "description": "baseline Ponytail, selected style, Codebase Memory, Wigolo, and RTK policy.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-env --allow-read --allow-run \"${CODEX_HOME:-$HOME/.codex}/hooks/workstyle.ts\"",
            "commandWindows": "deno run --quiet --allow-env --allow-read --allow-run (Join-Path $(if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $HOME '.codex' }) 'hooks\\workstyle.ts')",
            "timeout": 5,
            "additionalContextLimit": 900,
            "statusMessage": "loading workstyle policy"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet --allow-env --allow-read --allow-run \"${CODEX_HOME:-$HOME/.codex}/hooks/workstyle.ts\"",
            "commandWindows": "deno run --quiet --allow-env --allow-read --allow-run (Join-Path $(if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $HOME '.codex' }) 'hooks\\workstyle.ts')",
            "timeout": 5,
            "additionalContextLimit": 900,
            "statusMessage": "loading workstyle policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --quiet \"${CODEX_HOME:-$HOME/.codex}/hooks/rtk-guard.ts\"",
            "commandWindows": "deno run --quiet (Join-Path $(if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $HOME '.codex' }) 'hooks\\rtk-guard.ts')",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
